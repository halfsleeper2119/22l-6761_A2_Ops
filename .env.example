# Copy to .env and fill in real values. .env is git-ignored and never committed.
# (No comments after values: Docker Compose and python-dotenv parse those differently.)

# --- MLflow on DagsHub (training scripts) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/<RollNumber>_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# --- Web app (run_web.py) ---
# local = load the model in the web process; remote = call the model API at MODEL_API_URL
INFERENCE_MODE=local
MODEL_PATH=models/champion.keras
# Leave THRESHOLD and MODEL_VERSION empty to use models/champion.txt (written by registry.py export)
THRESHOLD=
MODEL_VERSION=
DATABASE_URL=sqlite:///visionguard.db
MAX_UPLOAD_MB=5
PORT=8000

# --- Docker Compose PostgreSQL (Task 6) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=visionguard

# --- Remote mode (Task 8) ---
MODEL_API_URL=http://<cloud-ip-or-domain>:8001
MODEL_API_KEY=<long-random-string>

# --- Model API (run_api.py) ---
API_PORT=8001
API_KEY=<long-random-string>
